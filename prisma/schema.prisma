generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Status {
  ACTIVE
  INVITED
  REMOVED
  PENDING
}

enum SiteRole {
  ADMIN
  USER
}

enum OrganizationRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReviewType {
  USER
  ORGANISATION
  PLATFORM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonateStatus {
  SUCCEEDED
  FAILED
  PENDING
}

enum DonateType {
  USER
  PLATFORM
  ORGANIZATION
}

enum TaskStatus {
  PENDING
  CREATED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CLOSED
}

enum CategoryType {
  NATURE
  ANIMAL
  FOOD
  MEDICINE
  DONATION
}


enum HostType {
  USER
  ORGANIZATION
}

model ChatRoom {
  id           String               @id @default(cuid())
  ownerId      Int
  name         String?
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  messages     ChatMessage[]        @relation("RoomMessages")
  owner        User                 @relation("ChatRoomOwner", fields: [ownerId], references: [id])
  participants UserStatusesInChat[] @relation("RoomParticipants")
}

model UserStatusesInChat {
  id       String    @id @default(cuid())
  userId   Int
  roomId   String
  wasLeft  Boolean   @default(false)
  leftAt   DateTime?
  joinedAt DateTime  @default(now())
  room     ChatRoom  @relation("RoomParticipants", fields: [roomId], references: [id])
  user     User      @relation("UserStatusesInChats", fields: [userId], references: [id])

  @@unique([userId, roomId])
}

model ChatMessage {
  id         String                @id @default(cuid())
  senderId   Int
  roomId     String
  content    String
  createdAt  DateTime              @default(now())
  room       ChatRoom              @relation("RoomMessages", fields: [roomId], references: [id])
  sender     User                  @relation("UserMessages", fields: [senderId], references: [id])
  reactions  ChatMessageReaction[]
  readStatus ReadStatus[]

  @@index([roomId])
  @@index([senderId])
  @@index([roomId, createdAt])
}

model ChatMessageReaction {
  id        Int         @id @default(autoincrement())
  messageId String
  userId    Int
  reaction  String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model ReadStatus {
  userId    Int
  messageId String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@id([userId, messageId])
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  title_en    String?
  title_de    String?
  category    String   @default("uncategorized")
  content     String
  content_en  String?
  content_de  String?
  image       String
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  picture     String?

  hostId      Int
  host        Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  startDate   DateTime
  startTime   DateTime
  endDate     DateTime?
  location    Unsupported("geography")?
  locationName String?
  status      TaskStatus @default(PENDING)

  joinedUsers User[] @relation("JoinedTasks")
  categories  CategoryType[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}




model User {
  id                         Int                   @id @default(autoincrement())
  email                      String                @unique
  name                       String
  password                   String
  siteRole                   SiteRole              @default(USER)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  bio                        String?
  avatar                     String?
  gender                     Gender?
  birthDate                  DateTime?
  phoneNumber                String?               @unique
  isEmailVerified            Boolean               @default(false)
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  resetPasswordToken         String?
  resetPasswordExpiresAt     DateTime?
  locationId                 Int?


  messages                   ChatMessage[]         @relation("UserMessages")
  ChatMessageReaction        ChatMessageReaction[]
  ownedRooms                 ChatRoom[]            @relation("ChatRoomOwner")
  readStatus                 ReadStatus[]
  refreshTokens              RefreshToken[]
  reviewsWritten             Review[]              @relation("AuthorReviews")
  reviewsReceived            Review[]              @relation("TargetReviews")
  location                   Location?             @relation(fields: [locationId], references: [id])
  organizations              UserOrganization[]
  userSettings               UserSettings?
  userInChats                UserStatusesInChat[]  @relation("UserStatusesInChats")
  joinedTasks                Task[]                @relation("JoinedTasks")
  paymentOptions             PaymentOption[]       @relation("UserPaymentOptions")


  hostProfile                Host?
}

model UserSettings {
  id       Int    @id @default(autoincrement())
  userId   Int    @unique
  theme    String @default("dark")
  language String @default("en")
  user     User   @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String
  userId    Int
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}

model PaymentOption {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[] @relation("UserPaymentOptions")
}

model Location {
  id      Int    @id @default(autoincrement())
  country String
  region  String
  city    String
  users   User[]
}

model Organization {
  id        String             @id @default(uuid())
  name      String             @unique
  createdAt DateTime           @default(now())
  members   UserOrganization[]
  hostProfile Host?
}

model UserOrganization {
  id             String           @id @default(uuid())
  userId         Int
  organizationId String
  role           OrganizationRole @default(MEMBER)
  status         Status           @default(PENDING)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
}

model Review {
  id        String   @id @default(cuid())
  authorId  Int
  targetId  Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  author    User     @relation("AuthorReviews", fields: [authorId], references: [id])
  target    User     @relation("TargetReviews", fields: [targetId], references: [id])

  @@index([targetId])
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}


model Donate {
  id              Int           @id @default(autoincrement())
  amount          Decimal
  currency        String
  status          DonateStatus  @default(PENDING)
  transactionId   String        @unique
  donationType    DonateType    @default(USER)
  userId          Int?
  organizationId  Int?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  message         String?
  name            String?
  receiptUrl      String?
}

model Host {
  id             Int           @id @default(autoincrement())
  type           HostType
  userId         Int?          @unique 
  organizationId String?       @unique 

  user           User?         @relation(fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  tasks          Task[]

}
