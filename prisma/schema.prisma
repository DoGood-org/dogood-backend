// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
//User model
// This model represents a user in the system

model User {
  id            Int                @id @default(autoincrement())
  email         String             @unique
  name          String
  password      String
  siteRole      SiteRole           @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  organizations UserOrganization[]
  hostedEvents  Event[]            @relation("HostedEvents")
  joinedEvents  Event[]            @relation("JoinedEvents")
  settings      Json?
  avatar        String?

  messages            ChatMessage[]         @relation("UserMessages")
  userInChats         UserStatusesInChat[]  @relation("UserStatusesInChats")
  ownedRooms          ChatRoom[]            @relation("ChatRoomOwner")
  readStatus          ReadStatus[]
  ChatMessageReaction ChatMessageReaction[]
}
// Enum definitions for roles and statuses
// These enums define the possible roles a user can have in an organization and their status within it
enum Role {
  ADMIN
  MEMBER
}

enum Status {
  ACTIVE
  INVITED
  REMOVED
  PENDING
}

enum SiteRole {
  ADMIN
  USER
}
// Organization model
// This model represents an organization that users can belong to
model Organization {
  id        String             @id @default(uuid())
  name      String
  createdAt DateTime           @default(now())
  members   UserOrganization[]
}
model UserOrganization {
  id             String       @id @default(uuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  role           Role         @default(MEMBER)
  status         Status       @default(PENDING)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}
// Chat models
// These models represent the chat functionality in the application, including chat rooms, messages, and user statuses in chats
model ChatRoom {
  id           String               @id @default(cuid())
  ownerId      Int
  owner        User                 @relation("ChatRoomOwner", fields: [ownerId], references: [id]) 
  name         String?
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  messages     ChatMessage[]        @relation("RoomMessages")
  participants UserStatusesInChat[] @relation("RoomParticipants")
}

model UserStatusesInChat {
  id     String               @id @default(cuid())
  userId Int
  roomId String
  user User     @relation("UserStatusesInChats", fields: [userId], references: [id])
  room ChatRoom @relation("RoomParticipants", fields: [roomId], references: [id])

  wasLeft  Boolean   @default(false)
  leftAt   DateTime?
  joinedAt DateTime  @default(now())

  @@unique([userId, roomId])
}

model ChatMessage {
  id        String               @id @default(cuid())
  senderId  Int
  roomId    String
  content   String
  createdAt DateTime             @default(now())

  sender    User                 @relation("UserMessages", fields: [senderId], references: [id])
  room      ChatRoom            @relation("RoomMessages", fields: [roomId], references: [id])

  readStatus ReadStatus[]
  reactions  ChatMessageReaction[]

  @@index([roomId])                  // Fast lookup by room
  @@index([senderId])               // Fast lookup by sender
  @@index([roomId, createdAt])      // Fast chronological queries in room
}

model ChatMessageReaction {
  id        Int      @id @default(autoincrement())
  messageId String
  userId    Int
  reaction  String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model ReadStatus {
  userId    Int
  messageId String
  readAt    DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id])
  message ChatMessage @relation(fields: [messageId], references: [id])

  @@id([userId, messageId])
}

// Post model
model Post {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   @default("uncategorized")
  content     String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
// Event model
// This model represents an event that users can host or join
model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  hostId      Int
  host        User       @relation("HostedEvents", fields: [hostId], references: [id])
  startTime   DateTime
  endTime     DateTime
  latitude    Float
  longitude   Float
  categories  Category[] @relation("EventCategories")
  joinedUsers User[]     @relation("JoinedEvents")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
// Category model
// This model represents a category that events can belong to
model Category {
  id     Int     @id @default(autoincrement())
  name   String
  events Event[] @relation("EventCategories")
}



