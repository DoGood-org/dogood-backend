              "raw": "{\r\n  \"title\": \"Автоматизоване тестове завдання\",\r\n  \"description\": \"Тестовий опис завдання для перевірки API\",\r\n  \"isOrganization\": false,\r\n  \"startDate\": \"2026-09-01T10:00:00.000Z\",\r\n  \"startTime\": \"2026-09-01T10:00:00.000Z\",\r\n  \"categories\": [\"NATURE\"]\r\n}",
