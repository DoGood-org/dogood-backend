generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
  PENDING
}

enum SiteRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum BlockType {
  THREE_DAYS
  ONE_WEEK
  ONE_MONTH
  CUSTOM
  PERMANENT
}

enum OrganizationRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReviewAuthorType {
  USER
  ORGANIZATION
  HOST
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonateStatus {
  SUCCEEDED
  FAILED
  PENDING
}

enum TaskStatus {
  PENDING
  CREATED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CLOSED
}

enum CategoryType {
  NATURE
  ANIMAL
  FOOD
  MEDICINE
  DONATION
}

enum HostType {
  USER
  ORGANIZATION
}

enum SupportMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EntityType {
  TASK
  ORGANIZATION
  REVIEW
  USER
  CHAT
}

enum NotificationType {
  ORG_JOIN_REQUEST_RECEIVED
  ORG_JOIN_REQUEST_ACCEPTED
  ORG_JOIN_REQUEST_REJECTED
  ORG_MEMBER_REMOVED
  ORG_ROLE_UPDATED
  ORG_NEW_MODERATOR

  TASK_VALIDATED
  TASK_REJECTED
  TASK_STARTING_SOON
  TASK_COMPLETED
  TASK_CLOSED

  REVIEW_RECEIVED
  REVIEW_APPROVED
  REVIEW_REJECTED

  CHAT_MESSAGE_RECEIVED
  SERVICE_MESSAGE_RECEIVED
}

model Chat {
  id          String    @id @default(uuid())
  ownerId     String
  name        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  messages     ChatMessage[]    @relation("ChatMessages")
  owner        User             @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants ChatMembership[] @relation("ChatParticipants")
}

model ChatMembership {
  id        String    @id @default(uuid())
  userId    String
  chatId    String
  leftAt    DateTime?
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  chat Chat @relation("ChatParticipants", fields: [chatId], references: [id])
  user User @relation("UserChatMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
}

model ChatMessage {
  id        String    @id @default(uuid())
  senderId  String
  chatId    String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  chat       Chat                  @relation("ChatMessages", fields: [chatId], references: [id])
  sender     User                  @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reactions  ChatMessageReaction[]
  readStatus ReadStatus[]

  @@index([chatId])
  @@index([senderId])
  @@index([chatId, createdAt])
}

model ChatMessageReaction {
  id        String    @id @default(uuid())
  messageId String
  userId    String
  reaction  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  message ChatMessage @relation(fields: [messageId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model ReadStatus {
  userId    String
  messageId String
  readAt    DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  message ChatMessage @relation(fields: [messageId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@id([userId, messageId])
}

model Post {
  id         String   @id @default(uuid())
  title      String
  title_en   String?
  title_de   String?
  category   String   @default("uncategorized")
  content    String
  content_en String?
  content_de String?
  image      String
  tags       String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SupportMessage {
  id        String               @id @default(uuid())
  userId    String?
  email     String
  subject   String
  message   String
  status    SupportMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  deletedAt DateTime?

  user User? @relation(fields: [userId], references: [id])
}

model Task {
  id            String            @id @default(uuid())
  title         String
  description   String
  imageUrl      String?
  status        TaskStatus        @default(PENDING)
  hostId        String
  host          Host              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime?
  locationId    String?
  location      Location?         @relation(fields: [locationId], references: [id])
  participants  TaskParticipant[]
  categories    CategoryType[]
  reviews       TaskReview[]
  amount        Int?
  currentAmount Int?
  currency      String?
  requirements  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
}

model User {
  id                         String                    @id @default(uuid())
  email                      String                    @unique
  name                       String
  password                   String
  role                       SiteRole                  @default(USER)
  isEmailVerified            Boolean                   @default(false)
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  resetPasswordToken         String?
  resetPasswordExpiresAt     DateTime?
  status                     UserStatus                @default(ACTIVE)
  locationId                 String?
  location                   Location?                 @relation(fields: [locationId], references: [id])
  stripeCustomerId           String?                   @unique
  ban                        UserBan?
  bansIssued                 UserBan[]                 @relation("AdminBanActions")
  userProfile                UserProfile?
  userSettings               UserSettings?
  refreshTokens              RefreshToken[]
  hostProfile                Host?
  joinRequestsSent           OrganizationJoinRequest[] @relation("JoinRequestSender")
  invitesReceived            OrganizationInvite[]      @relation("InviteReceiverUser")
  messages                   ChatMessage[]             @relation("UserMessages")
  chatMessageReactions       ChatMessageReaction[]
  chatMemberships            ChatMembership[]          @relation("UserChatMemberships")
  ownedChats                 Chat[]                    @relation("ChatOwner")
  readStatus                 ReadStatus[]
  userReviewsWritten         UserReview[]              @relation("UserReviewAuthorUser")
  orgReviewsWritten          OrganizationReview[]      @relation("OrgReviewAuthorUser")
  taskReviewsWritten         TaskReview[]              @relation("TaskReviewAuthorUser")
  systemReviewsWritten       SystemReview[]            @relation("SystemReviewAuthorUser")
  reviewsReceived            UserReview[]              @relation("UserReviewTarget")
  notifications              Notification[]            @relation("UserNotification")
  supportMessages            SupportMessage[]
  contact                    Contact?
  organizations              UserOrganization[]
  taskParticipations         TaskParticipant[]
  donates                    Donate[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  deletedAt                  DateTime?
}

model UserBan {
  id           String    @id @default(uuid())
  userId       String    @unique
  banType      BlockType
  banReason    String?
  banExpiresAt DateTime?
  bannedById   String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannedBy     User?     @relation("AdminBanActions", fields: [bannedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  bio         String?
  avatar      String?
  gender      Gender?
  birthDate   DateTime?
  phoneNumber String?   @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model UserSettings {
  id        String    @id @default(uuid())
  userId    String    @unique
  theme     String    @default("dark")
  language  String    @default("en")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  ip        String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id          String    @id @default(uuid())
  country     String?
  region      String?
  city        String?
  name        String?
  coordinates Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users         User[]
  organizations Organization[]
  tasks         Task[]
}

model Organization {
  id             String  @id @default(uuid())
  name           String  @unique
  additionalInfo String?
  phoneNumber    String?
  email          String?
  description    String?
  avatarUrl      String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  stripeCustomerId String? @unique

  joinRequestsReceived OrganizationJoinRequest[] @relation("JoinRequestReceiverOrganization")
  invitesSent          OrganizationInvite[]      @relation("InviteSenderOrganization")

  userReviewsWritten   UserReview[]         @relation("UserReviewAuthorOrg")
  orgReviewsWritten    OrganizationReview[] @relation("OrgReviewAuthorOrg")
  taskReviewsWritten   TaskReview[]         @relation("TaskReviewAuthorOrg")
  systemReviewsWritten SystemReview[]       @relation("SystemReviewAuthorOrg")
  reviewsReceived      OrganizationReview[] @relation("OrgReviewTarget")

  members     UserOrganization[]
  hostProfile Host?
  donates     Donate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([locationId])
}

model UserOrganization {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model OrganizationJoinRequest {
  id                     String            @id @default(uuid())
  senderId               String
  receiverOrganizationId String
  status                 JoinRequestStatus @default(PENDING)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?

  sender               User         @relation("JoinRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverOrganization Organization @relation("JoinRequestReceiverOrganization", fields: [receiverOrganizationId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverOrganizationId])
}

model OrganizationInvite {
  id                   String            @id @default(uuid())
  senderOrganizationId String
  receiverUserId       String
  status               JoinRequestStatus @default(PENDING)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  senderOrganization Organization @relation("InviteSenderOrganization", fields: [senderOrganizationId], references: [id], onDelete: Cascade)
  receiverUser       User         @relation("InviteReceiverUser", fields: [receiverUserId], references: [id], onDelete: Cascade)

  @@index([senderOrganizationId])
  @@index([receiverUserId])
}

model UserReview {
  id                   String           @id @default(uuid())
  rating               Int
  comment              String?
  authorType           ReviewAuthorType
  authorUserId         String?
  authorOrganizationId String?
  targetUserId         String
  status               ReviewStatus     @default(PENDING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  authorUser         User?         @relation("UserReviewAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorOrganization Organization? @relation("UserReviewAuthorOrg", fields: [authorOrganizationId], references: [id], onDelete: SetNull)
  targetUser         User          @relation("UserReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId])
  @@index([authorUserId])
  @@index([authorOrganizationId])
}

model OrganizationReview {
  id                   String           @id @default(uuid())
  rating               Int
  comment              String?
  authorType           ReviewAuthorType
  authorUserId         String?
  authorOrganizationId String?
  targetOrganizationId String
  status               ReviewStatus     @default(PENDING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  authorUser         User?         @relation("OrgReviewAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorOrganization Organization? @relation("OrgReviewAuthorOrg", fields: [authorOrganizationId], references: [id], onDelete: SetNull)
  targetOrganization Organization  @relation("OrgReviewTarget", fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  @@index([targetOrganizationId])
  @@index([authorUserId])
  @@index([authorOrganizationId])
}

model TaskReview {
  id                   String           @id @default(uuid())
  rating               Int
  comment              String?
  authorType           ReviewAuthorType
  authorUserId         String?
  authorOrganizationId String?
  taskId               String
  hostId               String
  status               ReviewStatus     @default(PENDING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  authorUser         User?         @relation("TaskReviewAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorOrganization Organization? @relation("TaskReviewAuthorOrg", fields: [authorOrganizationId], references: [id], onDelete: SetNull)
  task               Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  host               Host          @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([hostId])
  @@index([authorUserId])
  @@index([authorOrganizationId])
}

model SystemReview {
  id                   String           @id @default(uuid())
  rating               Int
  comment              String?
  authorType           ReviewAuthorType
  authorUserId         String?
  authorOrganizationId String?
  status               ReviewStatus     @default(PENDING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  authorUser         User?         @relation("SystemReviewAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorOrganization Organization? @relation("SystemReviewAuthorOrg", fields: [authorOrganizationId], references: [id], onDelete: SetNull)

  @@index([authorUserId])
  @@index([authorOrganizationId])
}

model TaskParticipant {
  id        String    @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Contact {
  id        String    @id @default(uuid())
  userId    String    @unique
  name      String
  email     String
  phone     String
  message   String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Donate {
  id             String       @id @default(uuid())
  amount         Decimal
  currency       String
  status         DonateStatus @default(PENDING)
  transactionId  String       @unique
  userId         String?
  organizationId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  message    String?
  name       String?
  receiptUrl String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
}

model Host {
  id             String        @id @default(uuid())
  type           HostType
  userId         String?       @unique
  organizationId String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  tasks          Task[]
  taskReviews    TaskReview[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  relatedId  String?
  entityType String?
  metadata   Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  user       User             @relation("UserNotification", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
