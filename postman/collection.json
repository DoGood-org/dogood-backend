                  "// 2. Збереження ID створеного завдання у змінну середовища\r",
                  "pm.test(\"Save Task ID to environment\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.data.task).to.have.property('id');\r",
                  "    pm.environment.set(\"taskId\", jsonData.data.task.id);\r",
                  "});"
