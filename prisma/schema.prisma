// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id           Int          @id @default(autoincrement())
  title        String
  description  String
  hostId       Int
  host         User         @relation("HostedEvents", fields: [hostId], references: [id])
  startTime    DateTime
  endTime      DateTime
  latitude     Float
  longitude    Float
  categories   Category[]   @relation("EventCategories")
  joinedUsers  User[]       @relation("JoinedEvents")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String
  hostedEvents  Event[]  @relation("HostedEvents")
  joinedEvents  Event[]  @relation("JoinedEvents")
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String
  events Event[] @relation("EventCategories")
}