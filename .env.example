# Server Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db?schema=public"

# JWT Secrets (використовуйте різні secrets для production)
JWT_ACCESS_SECRET=your-access-token-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-key-change-in-production

# JWT Expiration Times
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=DoGood <noreply@dogood.com>

SWAGGER_ENABLED=true
