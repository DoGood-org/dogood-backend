generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
  PENDING
}

enum SiteRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum BlockType {
  THREE_DAYS     
  ONE_WEEK       
  ONE_MONTH      
  CUSTOM         
  PERMANENT      
}

enum OrganizationRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum JoinRequestDirection {
  FROM_USER
  FROM_ORGANIZATION
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReviewTargetType {
  USER
  ORGANIZATION
  PLATFORM
}

enum ReviewAuthorType {
  USER
  ORGANIZATION
  HOST
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonateStatus {
  SUCCEEDED
  FAILED
  PENDING
}

enum DonateType {
  USER
  PLATFORM
  ORGANIZATION
}

enum TaskStatus {
  PENDING
  CREATED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CLOSED
}

enum CategoryType {
  NATURE
  ANIMAL
  FOOD
  MEDICINE
  DONATION
}

enum HostType {
  USER
  ORGANIZATION
}

enum SupportMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum EntityType {
  TASK
  ORGANIZATION
  REVIEW
  USER
  CHAT
}

enum NotificationType {
  ORG_JOIN_REQUEST_RECEIVED
  ORG_JOIN_REQUEST_ACCEPTED
  ORG_JOIN_REQUEST_REJECTED
  ORG_MEMBER_REMOVED
  ORG_ROLE_UPDATED
  ORG_NEW_MODERATOR

  TASK_VALIDATED
  TASK_REJECTED
  TASK_STARTING_SOON
  TASK_COMPLETED
  TASK_CLOSED

  REVIEW_RECEIVED
  REVIEW_APPROVED
  REVIEW_REJECTED

  CHAT_MESSAGE_RECEIVED
  SERVICE_MESSAGE_RECEIVED
}

// --- Models ---

model ChatRoom {
  id           String               @id @default(uuid())
  ownerId      String
  name         String?
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  messages     ChatMessage[]        @relation("RoomMessages")
  owner        User                 @relation("ChatRoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants UserStatusesInChat[] @relation("RoomParticipants")
}

model UserStatusesInChat {
  id       String   @id @default(uuid())
  userId   String
  roomId   String
  wasLeft  Boolean  @default(false)
  leftAt   DateTime?
  joinedAt DateTime @default(now())

  room     ChatRoom @relation("RoomParticipants", fields: [roomId], references: [id])
  user     User     @relation("UserStatusesInChats", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
}

model ChatMessage {
  id        String                @id @default(uuid())
  senderId  String
  roomId    String
  content   String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt 

  room      ChatRoom              @relation("RoomMessages", fields: [roomId], references: [id])
  sender    User                  @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reactions ChatMessageReaction[]
  readStatus ReadStatus[]

  @@index([roomId])
  @@index([senderId])
  @@index([roomId, createdAt])
}

model ChatMessageReaction {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  reaction  String
  createdAt DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model ReadStatus {
  userId    String
  messageId String
  readAt    DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@id([userId, messageId])
}

model Platform {
  id        String    @id @default(uuid())
  name      String
  reviews   Review[]  @relation("PlatformTargetReviews")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Post {
  id        String   @id @default(uuid())
  title     String
  title_en  String?
  title_de  String?
  category  String   @default("uncategorized")
  content   String
  content_en String?
  content_de String?
  image     String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportMessage {
  id        String   @id @default(uuid())
  email     String
  subject   String
  message   String
  status    SupportMessageStatus @default(NEW)
  createdAt DateTime @default(now())
}

model Task {
  id             String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  title          String
  description    String
  picture        String?
  status         TaskStatus @default(PENDING)

  hostId         String
  host           Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  startDate      DateTime
  startTime      DateTime
  endDate        DateTime?

  location       Json? // return later to Unsupported("geography")?
  locationId     String?  
  locationRef    Location? @relation(fields: [locationId], references: [id])
  locationName   String?

  joinedUsers User[] @relation("JoinedTasks", map: "JoinedUsers")
  categories     CategoryType[]

  reviews Review[] @relation("TaskReviews")

  amount         Int?
  currentAmount  Int?
  currency       String?
  requirements   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  password    String
  siteRole    SiteRole @default(USER)

  isEmailVerified            Boolean   @default(false)
  emailVerificationCode      String?
  emailVerificationExpiresAt DateTime?
  resetPasswordToken         String?
  resetPasswordExpiresAt     DateTime?

  status               UserStatus @default(ACTIVE)
  banType              BlockType? // null, if ACTIVE
  banReason            String?
  banExpiresAt         DateTime?  // null for PERMANENT, for others, the exact date of unlocking

  bannedById           String?
  bannedBy             User?      @relation("AdminBanActions", fields: [bannedById], references: [id])
  bannedUsers          User[]     @relation("AdminBanActions")

  profile      UserProfile?
  userSettings UserSettings?
  refreshTokens RefreshToken[]

  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  hostProfile  Host?

  stripeCustomerId String?  @unique

  joinRequestsSent     JoinRequest[] @relation("Sender")
  joinRequestsReceived JoinRequest[] @relation("ReceiverUser")

  messages             ChatMessage[]          @relation("UserMessages")
  chatMessageReactions ChatMessageReaction[]
  userInChats          UserStatusesInChat[]   @relation("UserStatusesInChats")
  ownedRooms           ChatRoom[]             @relation("ChatRoomOwner")
  readStatus           ReadStatus[]



  reviewsWrittenUser  Review[] @relation("AuthorUserReviews")
  reviewsReceived     Review[] @relation("TargetUserReviews")
  notifications Notification[] @relation("UserNotification")

  organizations  UserOrganization[]
  joinedTasks    Task[] @relation("JoinedTasks")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserProfile {
  id         String @id @default(uuid())
  userId     String @unique
  bio        String?
  avatar     String?
  gender     Gender?
  birthDate  DateTime?
  phoneNumber String? @unique

  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id       String @id @default(uuid())
  userId   String @unique
  theme    String @default("dark")
  language String @default("en")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @default(now()) @updatedAt
  revoked   Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Location {
  id      String @id @default(uuid())
  country String?
  region  String?
  city    String?

  users        User[]
  organization Organization[]
  tasks        Task[]
}

model Organization {
  id              String   @id @default(uuid())
  name            String   @unique
  createdAt       DateTime @default(now())
  phoneNumber     String?  
  email           String?
  description     String?
  moreInfo        String?
  avatar          String?

  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])

  stripeCustomerId String?  @unique

  joinRequestsSent     JoinRequest[] @relation("SenderOrganization")
  joinRequestsReceived JoinRequest[] @relation("ReceiverOrganization")

  reviews  Review[] @relation("TargetOrgReviews")
  reviewsWrittenOrg Review[] @relation("AuthorOrgReviews")

  members   UserOrganization[]
  hostProfile Host?

  @@index([locationId])
}

model UserOrganization {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(PENDING)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model JoinRequest {
  id                     String   @id @default(uuid())
  senderId               String?
  senderOrganizationId   String?
  receiverOrganizationId String?
  receiverUserId         String?
  status                 JoinRequestStatus @default(PENDING)
  direction              JoinRequestDirection
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sender             User?         @relation("Sender", fields: [senderId], references: [id])
  senderOrganization Organization? @relation("SenderOrganization", fields: [senderOrganizationId], references: [id])
  receiverOrganization Organization? @relation("ReceiverOrganization", fields: [receiverOrganizationId], references: [id])
  receiverUser       User?         @relation("ReceiverUser", fields: [receiverUserId], references: [id])

  @@index([senderId])
  @@index([receiverOrganizationId])
  @@index([receiverUserId])
}

model Review {
  id                   String               @id @default(uuid())
  rating               Int
  comment              String?
  authorType           ReviewAuthorType
  authorUserId         String?              
  authorOrganizationId String?            

  targetType           ReviewTargetType
  targetUserId         String?              
  targetOrganizationId String?      
  platformId           String? 
  taskId               String?       
   
  status               ReviewStatus         @default(PENDING)
  
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  authorUser           User? @relation("AuthorUserReviews", fields: [authorUserId], references: [id])
  targetUser           User? @relation("TargetUserReviews", fields: [targetUserId], references: [id])
  authorOrganization   Organization? @relation("AuthorOrgReviews", fields: [authorOrganizationId], references: [id])
  targetOrganization   Organization? @relation("TargetOrgReviews", fields: [targetOrganizationId], references: [id])
  task                 Task? @relation("TaskReviews", fields: [taskId], references: [id])  
  platform             Platform? @relation("PlatformTargetReviews", fields: [platformId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
}

model Donate {
  id             String   @id @default(uuid())
  amount         Decimal
  currency       String
  status         DonateStatus @default(PENDING)
  transactionId  String  @unique
  donationType   DonateType @default(USER)
  userId         String?
  organizationId String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  message        String?
  name           String?
  receiptUrl     String?
}

model Host {
  id             String   @id @default(uuid())
  type           HostType
  userId         String?  @unique
  organizationId String?  @unique

  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  tasks          Task[]
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           
  type        NotificationType
  
  title       String
  body        String
  
  relatedId   String?          
  entityType  String?          
  
  metadata    Json?            @default("{}")
  
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user        User             @relation("UserNotification", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}