    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1.0 Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 200 OK\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);  \r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"test_email\", \"user_\" + Date.now() + \"@gmail.com\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{test_email}}\",\r\n  \"password\": \"Password123!\",\r\n  \"name\": \"Oksana E2E Test\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.1 Login & Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Перевірка статусу 200 OK\r",
                  "pm.test(\"Status code is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Перевірка даних користувача та збереження токена\r",
                  "pm.test(\"User logged in & Token processed\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    \r",
                  "    // Перевіряємо, що у відповіді є об'єкт user\r",
                  "    pm.expect(jsonData.user).to.have.property('id');\r",
                  "    \r",
                  "    // Шукаємо токен спочатку в JSON, а якщо немає — у Cookies\r",
                  "    var token = jsonData.accessToken || jsonData.token;\r",
                  "    \r",
                  "    if (!token && pm.cookies.has(\"accessToken\")) {\r",
                  "        token = pm.cookies.get(\"accessToken\");\r",
                  "    }\r",
                  "    \r",
                  "    if (token) {\r",
                  "        pm.environment.set(\"accessToken\", token);\r",
                  "        console.log(\"Токен успішно збережено в оточення:\", token);\r",
                  "    } else {\r",
                  "        console.log(\"Токен не знайдено, але сесія збережена в Cookies\");\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{test_email}}\",\r\n  \"password\": \"Password123!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Перевіряємо статус 200 OK\r",
                  "pm.test(\"Status code is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Перевіряємо, що сервер повернув дані саме нашого користувача\r",
                  "pm.test(\"Correct user profile returned\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.user).to.have.property('email');\r",
                  "    pm.expect(jsonData.user.email).to.eql(\"ksu_new_test@gmail.com\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/current-user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "current-user"
              ]
            }
          },
          "response": []
        },
