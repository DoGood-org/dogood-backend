        {
          "name": "1.0.1 Verify Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.execution.skipRequest();\r\n// Скрипт отримує останній лист з MailHog і витягує код\r\npm.sendRequest({\r\n    url: 'http://localhost:8025/api/v2/messages',\r\n    method: 'GET'\r\n}, function (err, res) {\r\n    if (!err && res.code === 200) {\r\n        const messages = res.json().items;\r\n        const userEmail = pm.environment.get(\"test_email\");\r\n        \r\n        if (messages && messages.length > 0) {\r\n            // Шукаємо лист для нашого користувача\r\n            const userMessage = messages.find(m => \r\n                m.To && m.To.some(to => (to.Mailbox + \"@\" + to.Domain) === userEmail)\r\n            ) || messages[0]; // якщо не знайшли точне співпадіння, беремо найновіший лист\r\n\r\n            if (userMessage) {\r\n                const body = userMessage.Content.Body;\r\n                // Витягуємо токен/код (поліпшений регулярний вираз)\r\n                const match = body.match(/verify-email\\/([a-zA-Z0-9_-]+)/) || body.match(/code=([a-zA-Z0-9_-]+)/);\r\n                \r\n                if (match && match[1]) {\r\n                    pm.environment.set(\"verificationCode\", match[1]);\r\n                    console.log(\"Знайдено verificationCode:\", match[1]);\r\n                } else {\r\n                    console.log(\"Код не знайдено в тілі листа:\", body);\r\n                }\r\n            }\r\n        }\r\n    } else {\r\n        console.log(\"Помилка підключення до MailHog API:\", err);\r\n    }\r\n});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email/{{verificationCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email",
                "{{verificationCode}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.1 Login & Save Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Перевірка статусу 200 OK\r",
                  "pm.test(\"Status code is 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Перевірка даних користувача та збереження токенів\r",
                  "pm.test(\"User logged in & Token processed\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    // Перевіряємо, що у відповіді є об'єкт user\r",
                  "    pm.expect(jsonData.user).to.have.property('id');\r",
                  "\r",
                  "    // --- ACCESS TOKEN ---\r",
                  "    var token = jsonData.accessToken || jsonData.token;\r",
                  "\r",
                  "    if (!token && pm.cookies.has(\"accessToken\")) {\r",
                  "        token = pm.cookies.get(\"accessToken\");\r",
                  "    }\r",
                  "\r",
                  "    if (token) {\r",
                  "        pm.environment.set(\"accessToken\", token);\r",
                  "        console.log(\"accessToken успішно збережено в оточення:\", token);\r",
                  "    } else {\r",
                  "        console.log(\"accessToken не знайдено, але сесія збережена в Cookies\");\r",
                  "    }\r",
                  "\r",
                  "    // --- REFRESH TOKEN (ДОДАНО ДЛЯ ВИПРАВЛЕННЯ LOGOUT) ---\r",
                  "    var refreshToken = jsonData.refreshToken;\r",
                  "\r",
                  "    if (!refreshToken && pm.cookies.has(\"refreshToken\")) {\r",
                  "        refreshToken = pm.cookies.get(\"refreshToken\");\r",
                  "    }\r",
                  "\r",
                  "    if (refreshToken) {\r",
                  "        pm.environment.set(\"refreshToken\", refreshToken);\r",
                  "        console.log(\"refreshToken успішно збережено в оточення:\", refreshToken);\r",
                  "    } else {\r",
                  "        console.log(\"refreshToken не знайдено в відповіді\");\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{test_email}}\",\r\n  \"password\": \"Password123!\"\r\n}",
